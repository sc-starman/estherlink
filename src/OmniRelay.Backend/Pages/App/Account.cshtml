@page "/app/account"
@model OmniRelay.Backend.Pages.App.AccountModel
@{
    ViewData["Title"] = S["AppAccount.Title"];
    ViewData["DocumentationUrl"] = Model.DocumentationUrl;
}

<div class="max-w-3xl mx-auto px-4 py-10 space-y-6">
    <h1 class="text-3xl font-bold">@S["AppAccount.Title"]</h1>

    <article class="rounded-xl border border-slate-800 bg-slate-900 p-6">
        <dl class="grid sm:grid-cols-2 gap-4 text-sm">
            <div>
                <dt class="text-slate-400">@S["Common.Email"]</dt>
                <dd class="text-lg">@Model.Email</dd>
            </div>
            <div>
                <dt class="text-slate-400">@S["AppAccount.CreatedAtUtc"]</dt>
                <dd class="text-lg">@Model.CreatedAtUtc</dd>
            </div>
            <div>
                <dt class="text-slate-400">@S["AppAccount.TrialUsed"]</dt>
                <dd class="text-lg">@(Model.HasTrial ? S["Common.Yes"] : S["Common.No"])</dd>
            </div>
            <div>
                <dt class="text-slate-400">@S["AppAccount.PaidLicenses"]</dt>
                <dd class="text-lg">@Model.PaidLicenseCount</dd>
            </div>
        </dl>

        <form method="post" asp-page="/Account/Logout" class="mt-6">
            @Html.AntiForgeryToken()
            <button type="submit" class="px-4 py-2 rounded bg-slate-800 hover:bg-slate-700">@S["Layout.Nav.Logout"]</button>
        </form>
    </article>
</div>
