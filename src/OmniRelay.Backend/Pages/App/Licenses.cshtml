@page "/dashboard/licenses"
@model OmniRelay.Backend.Pages.App.LicensesModel
@{
    ViewData["Title"] = S["Licenses.Title"];
    ViewData["DashboardNav"] = "licenses";
}

<div class="max-w-7xl mx-auto px-4 py-10 grid md:grid-cols-[240px_1fr] gap-6">
    <partial name="_DashboardSidebar" view-data="ViewData" />

    <section class="space-y-6">
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold">@S["Licenses.Title"]</h1>
            <p class="text-slate-400 mt-1">@S["Licenses.Subtitle"]</p>
        </div>

        <article class="rounded-xl border border-slate-800 bg-slate-900 p-5 text-sm text-slate-300">
            <p class="font-semibold text-slate-100 mb-1">@S["Licenses.Policy.Title"]</p>
            <p>
                @Html.Raw(S["Licenses.Policy.Body"])
            </p>
        </article>

        @if (Model.Items.Count == 0)
        {
            <div class="rounded-xl border border-slate-800 bg-slate-900 p-6 text-slate-300">@S["Licenses.Empty"]</div>
        }
        else
        {
            <div class="space-y-3 md:hidden">
                @foreach (var item in Model.Items)
                {
                    <article class="rounded-xl border border-slate-800 bg-slate-900 p-4 space-y-3 text-sm">
                        <div class="flex items-start justify-between gap-3">
                            <div>
                                <p class="text-xs uppercase tracking-wide text-slate-400">@S["Licenses.Table.LicenseId"]</p>
                                <p class="font-mono text-xs break-all">@item.LicenseId</p>
                            </div>
                            <span class="rounded bg-slate-800 px-2 py-1 text-xs text-slate-200">@item.Status</span>
                        </div>

                        <div class="flex items-center gap-2">
                            <button
                                type="button"
                                class="show-license px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-xs"
                                data-license-id="@item.LicenseId"
                                data-license-key="@item.LicenseKey">
                                @S["Common.Show"]
                            </button>
                            <span class="text-xs text-slate-400">@S["Licenses.Table.LicenseKey"]</span>
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <p class="text-xs text-slate-400">@S["Licenses.Table.Plan"]</p>
                                <p>@item.Plan</p>
                            </div>
                            <div>
                                <p class="text-xs text-slate-400">@S["Licenses.Table.Term"]</p>
                                <p>@item.Term</p>
                            </div>
                            <div>
                                <p class="text-xs text-slate-400">@S["Licenses.Table.DeviceId"]</p>
                                <p class="font-mono text-xs">@(string.IsNullOrWhiteSpace(item.CurrentDeviceId) ? S["Common.NotAvailable"] : item.CurrentDeviceId)</p>
                            </div>
                            <div>
                                <p class="text-xs text-slate-400">@S["Licenses.Table.CreatedAt"]</p>
                                <p>@item.CreatedAt.ToString("u")</p>
                            </div>
                            <div>
                                <p class="text-xs text-slate-400">@S["Licenses.Table.Transfers"]</p>
                                <p>@item.TransfersUsedInWindow</p>
                            </div>
                            <div>
                                <p class="text-xs text-slate-400">@S["Licenses.Table.Remaining"]</p>
                                <p>@item.TransfersRemainingInWindow</p>
                            </div>
                            <div class="col-span-2">
                                <p class="text-xs text-slate-400">@S["Licenses.Table.LastSeen"]</p>
                                <p>@(item.LastSeenAt?.ToString("u") ?? S["Common.NotAvailable"])</p>
                            </div>
                        </div>
                    </article>
                }
            </div>

            <div class="hidden md:block overflow-x-auto rounded-xl border border-slate-800 bg-slate-900">
                <table class="min-w-full text-sm">
                    <thead class="bg-slate-950/70 text-slate-300">
                        <tr>
                            <th class="text-left px-4 py-3">@S["Licenses.Table.LicenseId"]</th>
                            <th class="text-left px-4 py-3">@S["Licenses.Table.LicenseKey"]</th>
                            <th class="text-left px-4 py-3">@S["Licenses.Table.DeviceId"]</th>
                            <th class="text-left px-4 py-3">@S["Licenses.Table.CreatedAt"]</th>
                            <th class="text-left px-4 py-3">@S["Licenses.Table.Term"]</th>
                            <th class="text-left px-4 py-3">@S["Licenses.Table.Status"]</th>
                            <th class="text-left px-4 py-3">@S["Licenses.Table.Plan"]</th>
                            <th class="text-left px-4 py-3">@S["Licenses.Table.Transfers"]</th>
                            <th class="text-left px-4 py-3">@S["Licenses.Table.Remaining"]</th>
                            <th class="text-left px-4 py-3">@S["Licenses.Table.LastSeen"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr class="border-t border-slate-800">
                            <td class="px-4 py-3 font-mono text-xs">@item.LicenseId</td>
                            <td class="px-4 py-3">
                                <button
                                    type="button"
                                    class="show-license px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-xs"
                                    data-license-id="@item.LicenseId"
                                    data-license-key="@item.LicenseKey">
                                    @S["Common.Show"]
                                </button>
                            </td>
                            <td class="px-4 py-3 font-mono">@(string.IsNullOrWhiteSpace(item.CurrentDeviceId) ? S["Common.NotAvailable"] : item.CurrentDeviceId)</td>
                            <td class="px-4 py-3">@item.CreatedAt.ToString("u")</td>
                            <td class="px-4 py-3">@item.Term</td>
                            <td class="px-4 py-3">@item.Status</td>
                            <td class="px-4 py-3">@item.Plan</td>
                            <td class="px-4 py-3">@item.TransfersUsedInWindow</td>
                            <td class="px-4 py-3">@item.TransfersRemainingInWindow</td>
                            <td class="px-4 py-3">@(item.LastSeenAt?.ToString("u") ?? S["Common.NotAvailable"])</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

<div id="licenseKeyModal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/60" data-close-modal></div>
    <div class="relative mx-auto mt-24 w-[92%] max-w-xl rounded-xl border border-slate-700 bg-slate-900 p-6 shadow-2xl">
        <div class="flex items-start justify-between gap-4">
            <div>
                <h2 class="text-xl font-semibold text-slate-100">@S["Licenses.Modal.Title"]</h2>
                <p id="licenseKeyModalId" class="mt-1 font-mono text-xs text-slate-400"></p>
            </div>
            <button type="button" class="rounded px-2 py-1 text-slate-300 hover:bg-slate-800" data-close-modal aria-label="@S["Common.Close"]">
                x
            </button>
        </div>

        <div class="mt-4 rounded-lg border border-slate-700 bg-slate-950 p-3">
            <code id="licenseKeyModalValue" class="break-all font-mono text-cyan-300"></code>
        </div>

        <div class="mt-4 flex items-center gap-3">
            <button type="button" id="licenseKeyModalCopy" class="rounded bg-cyan-500 px-3 py-2 text-sm font-semibold text-slate-900 hover:bg-cyan-400">
                @S["Js.Copy.Copy"]
            </button>
            <span id="licenseKeyModalCopyStatus" class="text-xs text-slate-400"></span>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const modal = document.getElementById("licenseKeyModal");
            if (!modal) return;

            const idEl = document.getElementById("licenseKeyModalId");
            const valueEl = document.getElementById("licenseKeyModalValue");
            const copyBtn = document.getElementById("licenseKeyModalCopy");
            const copyStatus = document.getElementById("licenseKeyModalCopyStatus");
            const i18n = window.omniRelayI18n || {};
            const copyLabel = i18n["copy.copy"] || @Html.Raw(System.Text.Json.JsonSerializer.Serialize(S["Js.Copy.Copy"].Value));
            const copiedLabel = i18n["copy.copied"] || @Html.Raw(System.Text.Json.JsonSerializer.Serialize(S["Js.Copy.Copied"].Value));
            const copyFailedLabel = i18n["copy.failed"] || @Html.Raw(System.Text.Json.JsonSerializer.Serialize(S["Js.Copy.Failed"].Value));
            const licenseIdPrefix = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(S["Licenses.Modal.LicenseId"].Value));
            let currentKey = "";

            const showModal = function (licenseId, key) {
                currentKey = key || "";
                if (idEl) idEl.textContent = `${licenseIdPrefix} ${licenseId || ""}`;
                if (valueEl) valueEl.textContent = currentKey;
                if (copyStatus) copyStatus.textContent = "";
                modal.classList.remove("hidden");
                document.body.classList.add("overflow-hidden");
            };

            const hideModal = function () {
                modal.classList.add("hidden");
                document.body.classList.remove("overflow-hidden");
                currentKey = "";
            };

            document.querySelectorAll(".show-license").forEach(function (button) {
                button.addEventListener("click", function () {
                    const target = button;
                    showModal(target.getAttribute("data-license-id"), target.getAttribute("data-license-key"));
                });
            });

            modal.querySelectorAll("[data-close-modal]").forEach(function (button) {
                button.addEventListener("click", hideModal);
            });

            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape" && !modal.classList.contains("hidden")) {
                    hideModal();
                }
            });

            if (copyBtn) {
                copyBtn.addEventListener("click", async function () {
                    if (!currentKey) return;
                    try {
                        await navigator.clipboard.writeText(currentKey);
                        if (copyStatus) copyStatus.textContent = copiedLabel;
                    } catch {
                        if (copyStatus) copyStatus.textContent = copyFailedLabel;
                    }
                    copyBtn.textContent = copyLabel;
                });
            }
        })();
    </script>
}
