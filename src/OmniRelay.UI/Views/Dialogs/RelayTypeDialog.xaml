<Window x:Class="OmniRelay.UI.Views.Dialogs.RelayTypeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Relay"
        Width="360"
        Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Background}">
    <StackPanel Margin="20">
        <TextBlock Text="Gateway Type" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,8"/>
        <ComboBox x:Name="GatewayTypeCombo" SelectedIndex="0" Style="{StaticResource FormComboBoxStyle}">
            <ComboBoxItem Content="Remote"/>
            <ComboBoxItem Content="Local"/>
        </ComboBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="Continue" Width="100" Click="Continue_Click" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </StackPanel>
</Window>
