<Window x:Class="OmniRelay.UI.Views.Dialogs.RelayEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relay Configuration"
        Width="900"
        Height="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">
    <Grid>
        <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <!-- <TextBlock Text="Relay" Style="{StaticResource SectionTitleTextStyle}"/> -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Name" Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="NameTextBox" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}"/>
                <CheckBox x:Name="EnabledCheckBox" Grid.Column="3" Content="Enabled" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="FeedbackTextBlock"
                       TextWrapping="Wrap"
                       Style="{StaticResource FeedbackTextStyle}"/>
            <Border Margin="0,8,0,0" Padding="10,8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Brush.Surface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Relay ID:" Style="{StaticResource FormLabelStyle}" Margin="0,0,8,0"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <TextBlock x:Name="RelayIdSummaryText" Style="{StaticResource ValueTextStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Button Content="Copy" Width="48" Height="22" MinHeight="0" Padding="6,0" Click="CopyRelayIdSummary_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Tunnel State:" Style="{StaticResource FormLabelStyle}" Margin="0,6,8,0"/>
                    <TextBlock x:Name="TunnelStateSummaryText" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Margin="0,6,16,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Health State:" Style="{StaticResource FormLabelStyle}" Margin="0,6,8,0"/>
                    <TextBlock x:Name="HealthStateSummaryText" Grid.Row="1" Grid.Column="3" Style="{StaticResource ValueTextStyle}" Margin="0,6,0,0"/>
                </Grid>
            </Border>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="Apply" Width="90" Margin="0,0,8,0" Click="Apply_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="Save" Width="90" Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>

        <TabControl x:Name="Tabs"
                    Style="{StaticResource AppTabControlStyle}"
                    ItemContainerStyle="{StaticResource AppTabItemStyle}"
                    SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="Networks">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="StatusGrid" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Incoming Network (IN)" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox x:Name="IncomingAdapterCombo" Grid.Row="0" Grid.Column="1" DisplayMemberPath="Display" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="IncomingAdapterCombo_SelectionChanged"/>
                        <TextBlock Grid.Row="1" Text="Outgoing Network (ON)" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox x:Name="OutgoingAdapterCombo" Grid.Row="1" Grid.Column="1" DisplayMemberPath="Display" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="OutgoingAdapterCombo_SelectionChanged"/>
                        <TextBlock Grid.Row="2" Text="IN MAC" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock x:Name="IncomingAdapterMacText" Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueTextStyle}"/>
                        <TextBlock Grid.Row="3" Text="ON MAC" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock x:Name="OutgoingAdapterMacText" Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueTextStyle}"/>
                        <TextBlock Grid.Row="4" Text="Gateway Type" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock x:Name="GatewayTypeText" Grid.Row="4" Grid.Column="1" Style="{StaticResource ValueTextStyle}"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="HostTab" Header="Host">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="HostGrid" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Host" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="TunnelHostTextBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}"/>
                        <TextBlock Grid.Row="1" Text="SSH Port" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="TunnelSshPortTextBox" Grid.Row="1" Grid.Column="1" Width="120" HorizontalAlignment="Left" Style="{StaticResource FormTextBoxStyle}"/>
                        <TextBlock Grid.Row="2" Text="User" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="TunnelUserTextBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}"/>
                        <TextBlock Grid.Row="3" Text="Authentication Method" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox x:Name="TunnelAuthMethodCombo" Grid.Row="3" Grid.Column="1" Width="220" HorizontalAlignment="Left" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="TunnelAuthMethodCombo_SelectionChanged" DropDownClosed="TunnelAuthMethodCombo_DropDownClosed"/>
                        <TextBlock Grid.Row="4" Text="Host Key File" Style="{StaticResource FormLabelStyle}"/>
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="TunnelKeyPathTextBox" Width="380" IsReadOnly="True" Style="{StaticResource FormTextBoxStyle}"/>
                            <Button Content="Browse Key" Click="BrowseTunnelKey_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,6,0,6"/>
                            <Button Content="Clear" Click="ClearTunnelKeyPath_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,6,0,6"/>
                        </StackPanel>
                        <TextBlock Grid.Row="5" Text="Key Passphrase" Style="{StaticResource FormLabelStyle}"/>
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                            <TextBlock x:Name="TunnelKeyPassphraseStateText" Width="90" VerticalAlignment="Center" Style="{StaticResource ValueTextStyle}"/>
                            <Button Content="Set Passphrase" Click="SetKeyPassphrase_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,6,0,6"/>
                            <Button Content="Clear" Click="ClearKeyPassphrase_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,6,0,6"/>
                        </StackPanel>
                        <TextBlock Grid.Row="6" Text="Password" Style="{StaticResource FormLabelStyle}"/>
                        <PasswordBox x:Name="TunnelPasswordBox" Grid.Row="6" Grid.Column="1" Style="{StaticResource FormPasswordBoxStyle}"/>
                        <TextBlock Grid.Row="7" Text="Operation" Style="{StaticResource FormLabelStyle}"/>
                        <WrapPanel Grid.Row="7" Grid.Column="1" Margin="0,8,0,0">
                            <Button Content="Test Connection" Width="130" Click="TestTunnel_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        </WrapPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="TunnelTab" Header="Tunnel">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="TunnelGrid" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="FRPS Port" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="FrpServerPortTextBox" Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left" Style="{StaticResource FormTextBoxStyle}"/>
                        <TextBlock Grid.Row="1" Text="FRP Token" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="FrpAuthTokenTextBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}"/>
                        <TextBlock Grid.Row="2" Text="Data Tunnel Remote Port" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="TunnelRemotePortTextBox" Grid.Row="2" Grid.Column="1" Width="120" HorizontalAlignment="Left" Style="{StaticResource FormTextBoxStyle}"/>
                        <TextBlock Grid.Row="3" Text="Tunnelctl Probe URL" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="TunnelProbeUrlTextBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}"/>
                        <TextBlock Grid.Row="4" Text="Bootstrap Mode" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox x:Name="BootstrapModeCombo" Grid.Row="4" Grid.Column="1" Width="220" HorizontalAlignment="Left" Style="{StaticResource FormComboBoxStyle}"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="DnsTab" Header="DNS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="DoH Endpoints" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="DohEndpointsTextBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}"/>
                        <TextBlock Grid.Row="1" Text="Operation" Style="{StaticResource FormLabelStyle}"/>
                        <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                            <Button Content="Apply DNS" Width="100" Click="ApplyDns_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="Check DNS" Width="100" Click="CheckDns_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="Repair DNS" Width="100" Click="RepairDns_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        </WrapPanel>
                        <TextBlock Grid.Row="2" Text="DNS Summary" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock x:Name="OperationDnsSummaryText" Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueTextStyle}" TextWrapping="Wrap"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Client Protocol">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="ClientProtocolGrid" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Protocol" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox x:Name="ProtocolCombo" Grid.Row="0" Grid.Column="1" Width="340" HorizontalAlignment="Left" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="ProtocolCombo_SelectionChanged" DropDownClosed="ProtocolCombo_DropDownClosed"/>
                        <TextBlock Grid.Row="1" Text="Public/Local Port" Style="{StaticResource FormLabelStyle}"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="ProtocolPortTextBox" Width="120" HorizontalAlignment="Left" Style="{StaticResource FormTextBoxStyle}"/>
                            <TextBlock x:Name="FixedProtocolPortsTextBlock" Margin="12,4,0,0" Style="{StaticResource MutedTextStyle}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="TLS Enabled" Style="{StaticResource FormLabelStyle}"/>
                        <CheckBox x:Name="ProtocolTlsEnabledCheckBox" Grid.Row="2" Grid.Column="1" Content="Enable TLS" Margin="0,8,0,0" Checked="ProtocolTlsEnabledCheckBox_Changed" Unchecked="ProtocolTlsEnabledCheckBox_Changed"/>
                        <TextBlock Grid.Row="3" Text="TLS Server Name" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="ProtocolTlsServerNameTextBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}"/>
                        <TextBlock Grid.Row="4" Text="TLS Mode" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox x:Name="ProtocolTlsModeCombo" Grid.Row="4" Grid.Column="1" Width="220" HorizontalAlignment="Left" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="ProtocolTlsModeCombo_SelectionChanged"/>
                        <TextBlock Grid.Row="5" Text="TLS Cert Path" Style="{StaticResource FormLabelStyle}"/>
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="ProtocolTlsCertPathTextBox" Width="380" IsReadOnly="True" Style="{StaticResource FormTextBoxStyle}"/>
                            <Button Content="Browse Cert" Click="BrowseTlsCertPath_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,6,0,6"/>
                            <Button Content="Clear" Click="ClearTlsCertPath_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,6,0,6"/>
                        </StackPanel>
                        <TextBlock Grid.Row="6" Text="TLS Key Path" Style="{StaticResource FormLabelStyle}"/>
                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="ProtocolTlsKeyPathTextBox" Width="380" IsReadOnly="True" Style="{StaticResource FormTextBoxStyle}"/>
                            <Button Content="Browse Key" Click="BrowseTlsKeyPath_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,6,0,6"/>
                            <Button Content="Clear" Click="ClearTlsKeyPath_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,6,0,6"/>
                        </StackPanel>
                        <TextBlock Grid.Row="7" Text="TLS ALPN" Style="{StaticResource FormLabelStyle}"/>
                        <ListBox x:Name="ProtocolTlsAlpnListBox" Grid.Row="7" Grid.Column="1" SelectionMode="Multiple" Height="90" HorizontalAlignment="Left" Width="260"/>
                        <TextBlock Grid.Row="8" Text="Proxy Username" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="GatewayProxyUsernameTextBox" Grid.Row="8" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}"/>
                        <TextBlock Grid.Row="9" Text="Proxy Password" Style="{StaticResource FormLabelStyle}"/>
                        <PasswordBox x:Name="GatewayProxyPasswordBox" Grid.Row="9" Grid.Column="1" Style="{StaticResource FormPasswordBoxStyle}"/>
                        <TextBlock Grid.Row="10" Text="VLESS Flow" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox x:Name="VlessFlowCombo" Grid.Row="10" Grid.Column="1" Width="260" HorizontalAlignment="Left" Style="{StaticResource FormComboBoxStyle}"/>
                        <TextBlock Grid.Row="11" Text="Hysteria2 Bandwidth" Style="{StaticResource FormLabelStyle}"/>
                        <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="Hysteria2UpMbpsTextBox" Width="80" Style="{StaticResource FormTextBoxStyle}"/>
                            <TextBlock Text="up /" Margin="8,10,8,0"/>
                            <TextBox x:Name="Hysteria2DownMbpsTextBox" Width="80" Style="{StaticResource FormTextBoxStyle}"/>
                            <TextBlock Text="down Mbps" Margin="8,10,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Row="12" Text="Hysteria2 OBFS Password" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="Hysteria2ObfsPasswordTextBox" Grid.Row="12" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}"/>
                        <TextBlock Grid.Row="13" Text="Hysteria2 Settings" Style="{StaticResource FormLabelStyle}"/>
                        <CheckBox x:Name="Hysteria2IgnoreClientBandwidthCheckBox" Grid.Row="13" Grid.Column="1" Content="Ignore client bandwidth" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="14" Text="Hysteria2 Masquerade URL" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="Hysteria2MasqueradeUrlTextBox" Grid.Row="14" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}"/>
                        <TextBlock Grid.Row="15" Text="Naive Network" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox x:Name="NaiveNetworkCombo" Grid.Row="15" Grid.Column="1" Width="220" HorizontalAlignment="Left" Style="{StaticResource FormComboBoxStyle}"/>
                        <TextBlock Grid.Row="16" Text="Naive QUIC CC" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="NaiveQuicCcTextBox" Grid.Row="16" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}"/>
                        <TextBlock Grid.Row="17" Text="Camouflage Server" Style="{StaticResource FormLabelStyle}"/>
                        <StackPanel Grid.Row="17" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="ShadowTlsCamouflageTextBox" Width="260" Style="{StaticResource FormTextBoxStyle}"/>
                            <Button Content="Switch Camouflage" Click="SwitchCamouflage_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,6,0,6"/>
                        </StackPanel>
                        <TextBlock Grid.Row="18" Text="ShadowTLS Strict Mode" Style="{StaticResource FormLabelStyle}"/>
                        <CheckBox x:Name="ShadowTlsStrictModeCheckBox" Grid.Row="18" Grid.Column="1" Content="Enable strict mode" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="19" Text="ShadowTLS Wildcard SNI" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="ShadowTlsWildcardSniTextBox" Grid.Row="19" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}"/>
                        <TextBlock Grid.Row="20" Text="OpenVPN Network" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="OpenVpnNetworkTextBox" Grid.Row="20" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}"/>
                        <TextBlock Grid.Row="21" Text="OpenVPN CA Cert" Style="{StaticResource FormLabelStyle}"/>
                        <StackPanel Grid.Row="21" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="OpenVpnSharedCaCertPathTextBox" Width="380" IsReadOnly="True" Style="{StaticResource FormTextBoxStyle}"/>
                            <Button Content="Browse" Click="BrowseOpenVpnSharedCaCertPath_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,6,0,6"/>
                            <Button Content="Clear" Click="ClearOpenVpnSharedCaCertPath_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,6,0,6"/>
                        </StackPanel>
                        <TextBlock Grid.Row="22" Text="OpenVPN Client Cert" Style="{StaticResource FormLabelStyle}"/>
                        <StackPanel Grid.Row="22" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="OpenVpnSharedClientCertPathTextBox" Width="380" IsReadOnly="True" Style="{StaticResource FormTextBoxStyle}"/>
                            <Button Content="Browse" Click="BrowseOpenVpnSharedClientCertPath_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,6,0,6"/>
                            <Button Content="Clear" Click="ClearOpenVpnSharedClientCertPath_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,6,0,6"/>
                        </StackPanel>
                        <TextBlock Grid.Row="23" Text="OpenVPN Client Key" Style="{StaticResource FormLabelStyle}"/>
                        <StackPanel Grid.Row="23" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="OpenVpnSharedClientKeyPathTextBox" Width="380" IsReadOnly="True" Style="{StaticResource FormTextBoxStyle}"/>
                            <Button Content="Browse" Click="BrowseOpenVpnSharedClientKeyPath_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,6,0,6"/>
                            <Button Content="Clear" Click="ClearOpenVpnSharedClientKeyPath_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,6,0,6"/>
                        </StackPanel>
                        <TextBlock Grid.Row="24" Text="OpenVPN tls-crypt Key" Style="{StaticResource FormLabelStyle}"/>
                        <StackPanel Grid.Row="24" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="OpenVpnSharedTlsCryptKeyPathTextBox" Width="380" IsReadOnly="True" Style="{StaticResource FormTextBoxStyle}"/>
                            <Button Content="Browse" Click="BrowseOpenVpnSharedTlsCryptKeyPath_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,6,0,6"/>
                            <Button Content="Clear" Click="ClearOpenVpnSharedTlsCryptKeyPath_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,6,0,6"/>
                        </StackPanel>
                        <TextBlock Grid.Row="25" Text="OpenVPN Bundle" Style="{StaticResource FormLabelStyle}"/>
                        <WrapPanel Grid.Row="25" Grid.Column="1" Margin="0,8,0,0">
                            <Button Content="Generate Bundle" Width="130" Click="GenerateOpenVpnBundle_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                            <Button Content="Export Bundle" Width="120" Click="ExportOpenVpnBundle_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/>
                        </WrapPanel>
                        <TextBlock Grid.Row="26" Text="OpenVPN Public IP / Domain" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="OpenVpnPublicHostTextBox" Grid.Row="26" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}"/>
                        <TextBlock Grid.Row="27" Text="IPSec/L2TP Network" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="IpsecL2tpNetworkTextBox" Grid.Row="27" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="AdminPanelTab" Header="Admin Panel">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="OmniPanel Port" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="PanelPortTextBox" Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left" Style="{StaticResource FormTextBoxStyle}"/>
                        <TextBlock Grid.Row="1" Text="OmniPanel User" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="PanelUserTextBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}"/>
                        <TextBlock Grid.Row="2" Text="OmniPanel Password" Style="{StaticResource FormLabelStyle}"/>
                        <PasswordBox x:Name="PanelPasswordBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource FormPasswordBoxStyle}"/>
                        <TextBlock Grid.Row="3" Text="OmniPanel Domain" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="PanelDomainTextBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}"/>
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <CheckBox x:Name="PanelDomainOnlyCheckBox" Content="Domain only" Margin="0,0,16,0"/>
                            <CheckBox x:Name="PanelUseSslCheckBox" Content="Use SSL" Margin="0,0,16,0" Checked="PanelUseSslCheckBox_Changed" Unchecked="PanelUseSslCheckBox_Changed"/>
                        </StackPanel>
                        <TextBlock x:Name="PanelSslModeLabel" Grid.Row="5" Text="SSL Mode" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox x:Name="PanelSslModeCombo" Grid.Row="5" Grid.Column="1" Width="220" HorizontalAlignment="Left" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="PanelSslModeCombo_SelectionChanged"/>
                        <TextBlock x:Name="PanelUploadedCertLabel" Grid.Row="6" Text="SSL Cert File" Style="{StaticResource FormLabelStyle}"/>
                        <StackPanel x:Name="PanelUploadedCertRow" Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="PanelUploadedCertPathTextBox" Width="380" IsReadOnly="True" Style="{StaticResource FormTextBoxStyle}"/>
                            <Button Content="Browse Cert" Click="BrowsePanelUploadedCertPath_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,6,0,6"/>
                            <Button Content="Clear" Click="ClearPanelUploadedCertPath_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,6,0,6"/>
                        </StackPanel>
                        <TextBlock x:Name="PanelUploadedKeyLabel" Grid.Row="7" Text="SSL Key File" Style="{StaticResource FormLabelStyle}"/>
                        <StackPanel x:Name="PanelUploadedKeyRow" Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="PanelUploadedKeyPathTextBox" Width="380" IsReadOnly="True" Style="{StaticResource FormTextBoxStyle}"/>
                            <Button Content="Browse Key" Click="BrowsePanelUploadedKeyPath_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,6,0,6"/>
                            <Button Content="Clear" Click="ClearPanelUploadedKeyPath_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,6,0,6"/>
                        </StackPanel>
                        <TextBlock x:Name="PanelLetsEncryptHintText" Grid.Row="8" Grid.Column="1" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" Text="Let's Encrypt is issued via certbot HTTP-01. A valid domain pointing to the VPS and inbound TCP/80 are required. Email is optional and not currently requested by this installer."/>
                        <TextBlock Grid.Row="9" Text="Operation" Style="{StaticResource FormLabelStyle}"/>
                        <WrapPanel Grid.Row="9" Grid.Column="1" Margin="0,8,0,0">
                            <Button Content="Open OmniPanel" Width="130" Click="OpenOmniPanel_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        </WrapPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="OperationsTab" Header="Gateway Control">
                <Grid Margin="10">
                    <StackPanel x:Name="OperationLockedPanel">
                        <TextBlock Text="Use Apply first so gateway operations can run against this saved Relay." Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>
                    <StackPanel x:Name="OperationContentPanel" Visibility="Collapsed">
                        <TextBlock Text="Gateway Operations" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="Test Tunnel" Width="130" Click="TestRuntimeTunnel_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="Bootstrap Check" Width="140" Click="BootstrapCheck_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="Clear Cached Sudo" Width="140" Click="ClearCachedSudo_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="Install" Width="90" Click="InstallGateway_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="Start" Width="90" Click="StartGateway_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="Stop" Width="90" Click="StopGateway_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="Uninstall" Width="100" Click="UninstallGateway_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="Health Check" Width="120" Click="HealthCheckGateway_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        </WrapPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Gateway Service State" Style="{StaticResource FormLabelStyle}"/>
                            <TextBlock x:Name="OperationGatewayServiceStateText" Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueTextStyle}"/>
                            <TextBlock Grid.Row="1" Text="Test Tunnel" Style="{StaticResource FormLabelStyle}"/>
                            <TextBlock x:Name="OperationBootstrapStateText" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueTextStyle}"/>
                            <TextBlock Grid.Row="2" Text="Health" Style="{StaticResource FormLabelStyle}"/>
                            <TextBlock x:Name="OperationHealthSummaryText" Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueTextStyle}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="3" Text="Sudo Password Cache" Style="{StaticResource FormLabelStyle}"/>
                            <TextBlock x:Name="OperationSudoCachedText" Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueTextStyle}"/>
                        </Grid>
                        <TextBlock x:Name="OperationFeedbackText" TextWrapping="Wrap" Style="{StaticResource FeedbackTextStyle}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Policies">
                <Grid Margin="10">
                    <StackPanel x:Name="PoliciesLockedPanel">
                        <TextBlock Text="Use Apply first so policy changes can be written to this Relay." Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>
                    <Grid x:Name="PoliciesContentPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Policy Lists" FontWeight="SemiBold"/>
                                <TextBlock Text="Top list has higher priority; first matching list wins." Style="{StaticResource MutedTextStyle}"/>
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                                <Button Content="Add List" Width="90" Click="AddPolicyList_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                                <Button Content="Edit" Width="90" Click="EditPolicyList_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                                <Button Content="Delete" Width="90" Click="DeletePolicyList_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                                <Button Content="Up" Width="70" Click="MovePolicyListUp_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                                <Button Content="Down" Width="70" Click="MovePolicyListDown_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                            </WrapPanel>
                            <TextBlock x:Name="PolicyListsSummaryText" Grid.Row="1" Text="No lists loaded." Style="{StaticResource MutedTextStyle}" Margin="0,0,0,8"/>
                            <DataGrid x:Name="PolicyListsGrid"
                                      Grid.Row="2"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      SelectionChanged="PolicyListsGrid_SelectionChanged"
                                      MouseDoubleClick="PolicyListsGrid_MouseDoubleClick"
                                      Style="{StaticResource AppDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Priority}" Width="50"/>
                                    <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding ListType}" Width="90"/>
                                    <DataGridTextColumn Header="Entries" Binding="{Binding EntryCount}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="PolicyListDetailSummaryText"
                                       Grid.Row="3"
                                       Text="Loaded 0 policy list(s)."
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="0,8,0,0"/>
                        </Grid>

                        <TextBlock x:Name="PolicyFeedbackText" Grid.Row="2" TextWrapping="Wrap" Style="{StaticResource FeedbackTextStyle}" Margin="0,8,0,0"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Status">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Status Stale" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock x:Name="StatusStaleText" Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueTextStyle}"/>
                        <TextBlock Grid.Row="1" Text="Proxy Running" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock x:Name="ProxyRunningText" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueTextStyle}"/>
                        <TextBlock x:Name="StatusRow2Label" Grid.Row="2" Text="Tunnel State" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock x:Name="TunnelStateText" Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueTextStyle}"/>
                        <TextBlock x:Name="StatusRow3Label" Grid.Row="3" Text="Health State" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock x:Name="HealthStateText" Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueTextStyle}"/>
                        <TextBlock x:Name="StatusRow4Label" Grid.Row="4" Text="Health Reason" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock x:Name="HealthReasonText" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" Style="{StaticResource ValueTextStyle}"/>
                        <TextBlock x:Name="StatusRow5Label" Grid.Row="5" Text="Recovery Tier" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock x:Name="RecoveryTierText" Grid.Row="5" Grid.Column="1" Style="{StaticResource ValueTextStyle}"/>
                        <TextBlock x:Name="StatusRow6Label" Grid.Row="6" Text="Recovery Action" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock x:Name="RecoveryActionText" Grid.Row="6" Grid.Column="1" TextWrapping="Wrap" Style="{StaticResource ValueTextStyle}"/>
                        <TextBlock x:Name="StatusRow7Label" Grid.Row="7" Text="Consecutive Failures" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock x:Name="ConsecutiveFailuresText" Grid.Row="7" Grid.Column="1" Style="{StaticResource ValueTextStyle}"/>
                        <TextBlock x:Name="StatusRow8Label" Grid.Row="8" Text="Last Healthy" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock x:Name="LastHealthyText" Grid.Row="8" Grid.Column="1" Style="{StaticResource ValueTextStyle}"/>
                        <TextBlock x:Name="StatusRow9Label" Grid.Row="9" Text="Last Local Probe" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock x:Name="LastLocalProbeText" Grid.Row="9" Grid.Column="1" Style="{StaticResource ValueTextStyle}"/>
                        <TextBlock x:Name="StatusRow10Label" Grid.Row="10" Text="Last End-to-End Probe" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock x:Name="LastEndToEndProbeText" Grid.Row="10" Grid.Column="1" Style="{StaticResource ValueTextStyle}"/>
                        <TextBlock x:Name="StatusRow11Label" Grid.Row="11" Text="Tunnel Last Error" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock x:Name="TunnelLastErrorText" Grid.Row="11" Grid.Column="1" TextWrapping="Wrap" Style="{StaticResource ValueTextStyle}"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        </DockPanel>
        <Border x:Name="ToastBorder"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,12,12,0"
                CornerRadius="6"
                Padding="12,8"
                Background="#1F2937"
                BorderBrush="#111827"
                BorderThickness="1"
                MaxWidth="420">
            <TextBlock x:Name="ToastTextBlock"
                       Foreground="White"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
