@page "/admin/trials"
@model OmniRelay.Backend.Pages.Admin.TrialsModel
@{
    ViewData["Title"] = "Admin Trial Licenses";
    ViewData["AdminNav"] = "trials";
}

<div class="max-w-7xl mx-auto px-4 py-10 grid md:grid-cols-[240px_1fr] gap-6">
    <partial name="_AdminSidebar" view-data="ViewData" />

    <section class="space-y-5">
        <div>
            <h1 class="text-3xl font-bold">Trial Licenses</h1>
            <p class="text-slate-400 mt-1">Source: <code>user_licenses.source = trial</code></p>
        </div>

        <div class="flex items-center justify-between text-sm text-slate-300">
            <p>Total: <strong>@Model.TotalItems</strong></p>
            <p>Page @Model.PageNumber / @Model.TotalPages</p>
        </div>

        @if (Model.Items.Count == 0)
        {
            <div class="rounded-xl border border-slate-800 bg-slate-900 p-6 text-slate-300">No trial licenses found.</div>
        }
        else
        {
            <div class="overflow-x-auto rounded-xl border border-slate-800 bg-slate-900">
                <table class="min-w-full text-sm">
                    <thead class="bg-slate-950/70 text-slate-300">
                        <tr>
                            <th class="text-left px-4 py-3">User Email</th>
                            <th class="text-left px-4 py-3">User ID</th>
                            <th class="text-left px-4 py-3">License ID</th>
                            <th class="text-left px-4 py-3">License Key</th>
                            <th class="text-left px-4 py-3">Plan</th>
                            <th class="text-left px-4 py-3">Status</th>
                            <th class="text-left px-4 py-3">Source</th>
                            <th class="text-left px-4 py-3">Created (UTC)</th>
                            <th class="text-left px-4 py-3">Expires (UTC)</th>
                            <th class="text-left px-4 py-3">Updates Until (UTC)</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr class="border-t border-slate-800">
                            <td class="px-4 py-3">@item.UserEmail</td>
                            <td class="px-4 py-3 font-mono text-xs">@item.UserId</td>
                            <td class="px-4 py-3 font-mono text-xs">@item.LicenseId</td>
                            <td class="px-4 py-3">
                                <button
                                    type="button"
                                    class="show-admin-license px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-xs"
                                    data-license-id="@item.LicenseId"
                                    data-license-key="@item.LicenseKey">
                                    Show
                                </button>
                            </td>
                            <td class="px-4 py-3">@item.Plan</td>
                            <td class="px-4 py-3">@item.Status.ToString().ToLowerInvariant()</td>
                            <td class="px-4 py-3">@item.Source</td>
                            <td class="px-4 py-3">@item.CreatedAt.ToString("u")</td>
                            <td class="px-4 py-3">@(item.ExpiresAt?.ToString("u") ?? "n/a")</td>
                            <td class="px-4 py-3">@(item.UpdatesEntitledUntil?.ToString("u") ?? "n/a")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="flex items-center justify-between">
                @if (Model.PageNumber > 1)
                {
                    <a class="rounded bg-slate-800 px-3 py-2 text-sm hover:bg-slate-700" href="/admin/trials?pageNumber=@(Model.PageNumber - 1)">Previous</a>
                }
                else
                {
                    <span class="rounded bg-slate-900 px-3 py-2 text-sm text-slate-500">Previous</span>
                }

                @if (Model.PageNumber < Model.TotalPages)
                {
                    <a class="rounded bg-slate-800 px-3 py-2 text-sm hover:bg-slate-700" href="/admin/trials?pageNumber=@(Model.PageNumber + 1)">Next</a>
                }
                else
                {
                    <span class="rounded bg-slate-900 px-3 py-2 text-sm text-slate-500">Next</span>
                }
            </div>
        }
    </section>
</div>

<div id="adminLicenseKeyModal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/60" data-close-admin-license-modal></div>
    <div class="relative mx-auto mt-24 w-[92%] max-w-xl rounded-xl border border-slate-700 bg-slate-900 p-6 shadow-2xl">
        <div class="flex items-start justify-between gap-4">
            <div>
                <h2 class="text-xl font-semibold text-slate-100">License Key</h2>
                <p id="adminLicenseKeyModalId" class="mt-1 font-mono text-xs text-slate-400"></p>
            </div>
            <button type="button" class="rounded px-2 py-1 text-slate-300 hover:bg-slate-800" data-close-admin-license-modal aria-label="Close">
                x
            </button>
        </div>

        <div class="mt-4 rounded-lg border border-slate-700 bg-slate-950 p-3">
            <code id="adminLicenseKeyModalValue" class="break-all font-mono text-cyan-300"></code>
        </div>

        <div class="mt-4 flex items-center gap-3">
            <button type="button" id="adminLicenseKeyModalCopy" class="rounded bg-cyan-500 px-3 py-2 text-sm font-semibold text-slate-900 hover:bg-cyan-400">
                Copy
            </button>
            <span id="adminLicenseKeyModalCopyStatus" class="text-xs text-slate-400"></span>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const modal = document.getElementById("adminLicenseKeyModal");
            if (!modal) return;

            const idEl = document.getElementById("adminLicenseKeyModalId");
            const valueEl = document.getElementById("adminLicenseKeyModalValue");
            const copyBtn = document.getElementById("adminLicenseKeyModalCopy");
            const copyStatus = document.getElementById("adminLicenseKeyModalCopyStatus");
            let currentKey = "";

            const showModal = function (licenseId, key) {
                currentKey = key || "";
                if (idEl) idEl.textContent = "License Id: " + (licenseId || "");
                if (valueEl) valueEl.textContent = currentKey;
                if (copyStatus) copyStatus.textContent = "";
                modal.classList.remove("hidden");
                document.body.classList.add("overflow-hidden");
            };

            const hideModal = function () {
                modal.classList.add("hidden");
                document.body.classList.remove("overflow-hidden");
                currentKey = "";
            };

            document.querySelectorAll(".show-admin-license").forEach(function (button) {
                button.addEventListener("click", function () {
                    const target = button;
                    showModal(target.getAttribute("data-license-id"), target.getAttribute("data-license-key"));
                });
            });

            modal.querySelectorAll("[data-close-admin-license-modal]").forEach(function (button) {
                button.addEventListener("click", hideModal);
            });

            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape" && !modal.classList.contains("hidden")) {
                    hideModal();
                }
            });

            if (copyBtn) {
                copyBtn.addEventListener("click", async function () {
                    if (!currentKey) return;
                    try {
                        await navigator.clipboard.writeText(currentKey);
                        if (copyStatus) copyStatus.textContent = "Copied.";
                    } catch {
                        if (copyStatus) copyStatus.textContent = "Copy failed.";
                    }
                });
            }
        })();
    </script>
}
