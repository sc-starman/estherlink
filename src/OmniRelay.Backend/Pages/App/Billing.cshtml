@page "/dashboard/billing"
@model OmniRelay.Backend.Pages.App.BillingModel
@{
    ViewData["Title"] = S["Billing.Title"];
    ViewData["DashboardNav"] = "billing";
}

<div class="max-w-7xl mx-auto px-4 py-10 grid md:grid-cols-[240px_1fr] gap-6">
    <partial name="_DashboardSidebar" view-data="ViewData" />

    <section class="space-y-8">
        <div>
            <h1 class="text-3xl font-bold mb-2">@S["Billing.Title"]</h1>
            <p class="text-slate-400">@S["Billing.Subtitle"]</p>
        </div>

        <section class="rounded-2xl border border-cyan-600/40 bg-slate-900 p-6">
            <div class="grid gap-6 lg:grid-cols-[1fr_320px]">
                <div class="space-y-5">
                    <div>
                        <h2 class="text-2xl font-bold">@S["Billing.OneTimeLicense"]</h2>
                        <p class="mt-2 text-slate-300">@S["Billing.OneTimeLicenseBody"]</p>
                        <p class="mt-3 text-sm text-slate-400">@S["Billing.BasePrice"]</p>
                        <p class="text-4xl font-bold text-cyan-300">$@Model.PriceUsd.ToString("0.00")</p>
                    </div>

                    <div class="rounded-xl border border-slate-700 bg-slate-950/60 p-4 space-y-3">
                        <p class="text-sm font-semibold text-slate-200">@S["Billing.CouponCode"]</p>
                        <div class="flex flex-wrap items-center gap-2">
                            <input
                                id="coupon-code-input"
                                type="text"
                                maxlength="64"
                                placeholder="@S["Billing.CouponPlaceholder"]"
                                class="w-full sm:w-64 rounded border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-slate-100 focus:border-cyan-400 focus:outline-none" />
                            <button
                                id="coupon-apply"
                                type="button"
                                class="rounded bg-cyan-500 px-3 py-2 text-sm font-semibold text-slate-900 hover:bg-cyan-400">
                                @S["Common.Apply"]
                            </button>
                            <button
                                id="coupon-clear"
                                type="button"
                                class="rounded bg-slate-800 px-3 py-2 text-sm text-slate-100 hover:bg-slate-700">
                                @S["Common.Remove"]
                            </button>
                        </div>
                        <p id="coupon-quote-message" class="text-xs text-slate-400"></p>
                    </div>

                    <div class="flex items-center gap-3">
                        <button
                            type="button"
                            data-action="create-intent"
                            class="px-5 py-2 rounded bg-cyan-500 text-slate-900 font-semibold hover:bg-cyan-400">
                            @S["Billing.CreatePaymentIntent"]
                        </button>
                        <span id="checkout-result" class="text-sm text-slate-300"></span>
                    </div>
                </div>

                <aside class="rounded-xl border border-slate-700 bg-slate-950/60 p-4 h-fit">
                    <h3 class="text-lg font-semibold mb-4">@S["Billing.CheckoutSummary"]</h3>
                    <dl class="space-y-2 text-sm">
                        <div class="flex items-center justify-between">
                            <dt class="text-slate-400">@S["Billing.Summary.Base"]</dt>
                            <dd id="summary-base" class="font-semibold">$@Model.InitialBaseAmount.ToString("0.00")</dd>
                        </div>
                        <div class="flex items-center justify-between">
                            <dt class="text-slate-400">@S["Billing.Summary.Discount"]</dt>
                            <dd id="summary-discount" class="font-semibold text-emerald-300">-$@Model.InitialDiscountAmount.ToString("0.00")</dd>
                        </div>
                        <div class="flex items-center justify-between">
                            <dt class="text-slate-400">@S["Billing.Summary.Coupon"]</dt>
                            <dd id="summary-coupon" class="font-mono text-xs text-slate-300">@S["Common.None"]</dd>
                        </div>
                        <div class="border-t border-slate-700 pt-3 mt-3 flex items-center justify-between">
                            <dt class="text-slate-200 font-semibold">@S["Billing.Summary.Final"]</dt>
                            <dd id="summary-final" class="text-xl font-bold text-cyan-300">$@Model.InitialFinalAmount.ToString("0.00")</dd>
                        </div>
                    </dl>
                </aside>
            </div>
        </section>

        <section>
            <h2 class="text-xl font-semibold mb-3">@S["Billing.PaymentAttempts"]</h2>
            @if (Model.Attempts.Count == 0)
            {
                <div class="rounded-xl border border-slate-800 bg-slate-900 p-4 text-slate-300">@S["Billing.NoPaymentAttempts"]</div>
            }
            else
            {
                <div class="overflow-x-auto rounded-xl border border-slate-800 bg-slate-900">
                    <table class="min-w-full text-sm">
                        <thead class="bg-slate-950/70 text-slate-300">
                            <tr>
                                <th class="text-left px-4 py-3">@S["Billing.Table.AttemptId"]</th>
                                <th class="text-left px-4 py-3">@S["Billing.Table.OrderId"]</th>
                                <th class="text-left px-4 py-3">@S["Billing.Table.Base"]</th>
                                <th class="text-left px-4 py-3">@S["Billing.Table.Discount"]</th>
                                <th class="text-left px-4 py-3">@S["Billing.Table.Final"]</th>
                                <th class="text-left px-4 py-3">@S["Billing.Table.Coupon"]</th>
                                <th class="text-left px-4 py-3">@S["Billing.Table.State"]</th>
                                <th class="text-left px-4 py-3">@S["Billing.Table.CreatedAt"]</th>
                                <th class="text-left px-4 py-3">@S["Billing.Table.UpdatedAt"]</th>
                                <th class="text-left px-4 py-3">@S["Billing.Table.IssuedLicense"]</th>
                                <th class="text-left px-4 py-3">@S["Billing.Table.ProviderMessage"]</th>
                                <th class="text-left px-4 py-3">@S["Billing.Table.Action"]</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model.Attempts)
                        {
                            <tr class="border-t border-slate-800">
                                <td class="px-4 py-3 font-mono">@(string.IsNullOrWhiteSpace(item.AttemptId) ? S["Common.NotAvailable"] : item.AttemptId)</td>
                                <td class="px-4 py-3 font-mono text-xs">@item.OrderId</td>
                                <td class="px-4 py-3">@item.BaseAmount.ToString("0.00") @item.Currency</td>
                                <td class="px-4 py-3 text-emerald-300">-@item.DiscountAmount.ToString("0.00") @item.Currency</td>
                                <td class="px-4 py-3 font-semibold">@item.Amount.ToString("0.00") @item.Currency</td>
                                <td class="px-4 py-3 font-mono text-xs">
                                    @(string.IsNullOrWhiteSpace(item.AppliedCouponCode)
                                        ? S["Common.None"].Value
                                        : $"{item.AppliedCouponCode} ({item.AppliedDiscountPercent ?? 0}%)")
                                </td>
                                <td class="px-4 py-3">@item.State</td>
                                <td class="px-4 py-3">@item.CreatedAt.ToString("u")</td>
                                <td class="px-4 py-3">@item.UpdatedAt.ToString("u")</td>
                                <td class="px-4 py-3">
                                    @if (!string.IsNullOrWhiteSpace(item.IssuedLicenseKey))
                                    {
                                        <span class="font-mono text-cyan-300">@item.IssuedLicenseKey</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400">@S["Common.Pending"]</span>
                                    }
                                </td>
                                <td class="px-4 py-3">@(item.ProviderMessage ?? S["Common.NotAvailable"].Value)</td>
                                <td class="px-4 py-3">
                                    <button class="poll-order px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-xs" data-order-id="@item.OrderId">@S["Common.Refresh"]</button>
                                    <div id="order-@item.OrderId" class="mt-1 text-xs text-slate-400"></div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </section>
</div>

<div id="payment-redirect-modal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-slate-950/70"></div>
    <div class="relative z-10 flex min-h-full items-center justify-center p-4">
        <div class="w-full max-w-lg rounded-2xl border border-cyan-500/40 bg-slate-900 shadow-xl">
            <div class="flex items-center justify-between border-b border-slate-800 px-5 py-4">
                <h3 class="text-lg font-semibold">@S["Billing.Modal.Title"]</h3>
                <button
                    type="button"
                    id="payment-redirect-close"
                    class="rounded p-1 text-slate-300 hover:bg-slate-800 hover:text-white"
                    aria-label="@S["Billing.Modal.CancelAria"]">
                    <span aria-hidden="true" class="text-xl leading-none">&times;</span>
                </button>
            </div>
            <div class="space-y-4 px-5 py-5">
                <p class="text-slate-200">
                    @S["Billing.Modal.RedirectPrefix"]
                    <span id="payment-redirect-countdown" class="font-semibold text-cyan-300">10</span>
                    @S["Billing.Modal.RedirectSuffix"]
                </p>
                <div class="rounded-lg border border-slate-700 bg-slate-950/50 px-4 py-3 text-sm text-slate-200 space-y-1">
                    <p>@S["Billing.Modal.AmountToPay"] <span id="payment-redirect-amount" class="font-semibold text-white">$0.00</span></p>
                    <p>@S["Billing.Modal.Coupon"] <span id="payment-redirect-coupon" class="font-mono text-xs text-slate-300">@S["Common.None"]</span></p>
                </div>
                <div class="flex justify-end gap-3">
                    <button
                        type="button"
                        id="payment-redirect-go-now"
                        class="px-4 py-2 rounded bg-cyan-500 text-slate-900 font-semibold hover:bg-cyan-400">
                        @S["Billing.Modal.GoNow"]
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="payment-waiting-modal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-slate-950/70"></div>
    <div class="relative z-10 flex min-h-full items-center justify-center p-4">
        <div class="w-full max-w-lg rounded-2xl border border-emerald-500/40 bg-slate-900 shadow-xl">
            <div class="flex items-center justify-between border-b border-slate-800 px-5 py-4">
                <h3 class="text-lg font-semibold">@S["Billing.WaitingModal.Title"]</h3>
                <button
                    type="button"
                    id="payment-waiting-close-icon"
                    class="rounded p-1 text-slate-300 hover:bg-slate-800 hover:text-white"
                    aria-label="@S["Common.Close"]">
                    <span aria-hidden="true" class="text-xl leading-none">&times;</span>
                </button>
            </div>
            <div class="space-y-4 px-5 py-5">
                <p class="text-slate-200">@S["Billing.WaitingModal.Body"]</p>
                <div class="rounded-lg border border-slate-700 bg-slate-950/50 px-4 py-3 text-sm text-slate-200 space-y-1">
                    <p>@S["Billing.Modal.AmountToPay"] <span id="payment-waiting-amount" class="font-semibold text-white">$0.00</span></p>
                    <p>@S["Billing.Modal.Coupon"] <span id="payment-waiting-coupon" class="font-mono text-xs text-slate-300">@S["Common.None"]</span></p>
                </div>
                <p class="text-sm text-slate-300">
                    @S["Billing.WaitingModal.StatusLabel"]
                    <span id="payment-waiting-status" class="font-semibold text-cyan-300">@S["Billing.WaitingModal.StatusWaiting"]</span>
                </p>
                <div class="flex justify-end gap-3">
                    <button
                        type="button"
                        id="payment-waiting-check"
                        class="px-4 py-2 rounded bg-cyan-500 text-slate-900 font-semibold hover:bg-cyan-400">
                        @S["Billing.WaitingModal.CheckNow"]
                    </button>
                    <button
                        type="button"
                        id="payment-waiting-close"
                        class="px-4 py-2 rounded bg-slate-800 text-slate-100 hover:bg-slate-700">
                        @S["Common.Close"]
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
