@page "/download"
@model OmniRelay.Backend.Pages.DownloadModel
@{
    ViewData["Title"] = S["Download.Title"];
}

<section class="max-w-7xl mx-auto px-4 py-10 space-y-10">
    <header class="space-y-3">
        <p class="text-cyan-300 uppercase tracking-[0.18em] text-xs font-semibold">@S["Download.Eyebrow"]</p>
        <h1 class="text-4xl md:text-5xl font-bold leading-tight">@S["Download.HeroTitle"]</h1>
        <p class="text-slate-300 max-w-3xl">
            @S["Download.HeroBody"]
        </p>
        <a href="/changelogs"
           class="inline-flex items-center justify-center rounded-md border border-cyan-400/40 px-4 py-2 text-sm font-semibold text-cyan-300 hover:border-cyan-300 hover:text-cyan-200">
            @S["Download.Changelogs.Link"]
        </a>
    </header>

    <div class="grid gap-6 md:grid-cols-2">
        <article class="rounded-2xl border border-slate-800 bg-slate-900/80 p-6 space-y-4">
            <div class="flex items-center justify-between gap-4">
                <h2 class="text-2xl font-semibold">@S["Download.Windows.Title"]</h2>
                <span class="inline-flex items-center rounded-full border border-cyan-400/40 px-3 py-1 text-xs text-cyan-300">
                    @S["Download.Windows.Stable"]
                </span>
            </div>

            @if (Model.WindowsRelease is null)
            {
                <p class="text-slate-300">@S["Download.Windows.None"]</p>
            }
            else
            {
                <ul class="text-sm text-slate-300 space-y-2">
                    <li><span class="text-slate-400">@S["Download.Windows.Version"]</span> @Model.WindowsRelease.Version</li>
                    <li><span class="text-slate-400">@S["Download.Windows.Published"]</span> @Model.WindowsRelease.PublishedAt.ToString("u")</li>
                    <li class="break-all"><span class="text-slate-400">@S["Download.Windows.Sha"]</span> <span class="font-mono text-xs">@Model.WindowsRelease.Sha256</span></li>
                </ul>

                <a href="/download/windows"
                   class="inline-flex items-center justify-center rounded-md bg-cyan-500 px-5 py-2.5 font-semibold text-slate-950 hover:bg-cyan-400">
                    @S["Download.Windows.Button"]
                </a>

                @if (!string.IsNullOrWhiteSpace(Model.WindowsRelease.Notes))
                {
                    <p class="text-sm text-slate-300 whitespace-pre-wrap">@Model.WindowsRelease.Notes</p>
                }
            }
        </article>

        <article class="rounded-2xl border border-slate-800 bg-slate-900/80 p-6 space-y-4">
            <div class="flex items-center justify-between gap-4">
                <h2 class="text-2xl font-semibold">@S["Download.Linux.Title"]</h2>
                <span class="inline-flex items-center rounded-full border border-amber-400/40 px-3 py-1 text-xs text-amber-300">
                    @S["Download.Linux.ComingSoon"]
                </span>
            </div>
            <p class="text-slate-300">
                @S["Download.Linux.Body"]
            </p>
            <button type="button"
                    class="inline-flex items-center justify-center rounded-md border border-slate-700 px-5 py-2.5 text-slate-400 cursor-not-allowed"
                    disabled>
                @S["Download.Linux.Button"]
            </button>
        </article>
    </div>

    <section class="grid gap-6 lg:grid-cols-2">
        <article class="rounded-2xl border border-slate-800 bg-slate-900/80 p-6 space-y-3">
            <h3 class="text-xl font-semibold">@S["Download.Recommended.Title"]</h3>
            <ul class="text-slate-300 space-y-2 text-sm">
                <li>@S["Download.Recommended.Item1"]</li>
                <li>@S["Download.Recommended.Item2"]</li>
                <li>@S["Download.Recommended.Item3"]</li>
                <li>@S["Download.Recommended.Item4"]</li>
            </ul>
        </article>

        <article class="rounded-2xl border border-slate-800 bg-slate-900/80 p-6 space-y-3">
            <h3 class="text-xl font-semibold">@S["Download.Minimum.Title"]</h3>
            <ul class="text-slate-300 space-y-2 text-sm">
                <li>@S["Download.Minimum.Item1"]</li>
                <li>@S["Download.Minimum.Item2"]</li>
                <li>@S["Download.Minimum.Item3"]</li>
                <li>@S["Download.Minimum.Item4"]</li>
            </ul>
        </article>
    </section>

    <section class="rounded-2xl border border-slate-800 bg-slate-900/80 p-6 space-y-4">
        <h3 class="text-xl font-semibold">@S["Download.QuickInstall.Title"]</h3>
        <ol class="list-decimal list-inside text-slate-300 space-y-2 text-sm">
            <li>@S["Download.QuickInstall.Item1"]</li>
            <li>@S["Download.QuickInstall.Item2"]</li>
            <li>@S["Download.QuickInstall.Item3"]</li>
            <li>@S["Download.QuickInstall.Item4"]</li>
            <li>@Html.Raw(S["Download.QuickInstall.Item5"])</li>
        </ol>
    </section>
</section>
