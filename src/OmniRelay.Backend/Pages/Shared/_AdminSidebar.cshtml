@{
    var current = (ViewData["AdminNav"] as string ?? string.Empty).Trim().ToLowerInvariant();
    string LinkClass(string key) =>
        current == key
            ? "block px-3 py-2 rounded-lg bg-cyan-500 text-slate-900 font-semibold"
            : "block px-3 py-2 rounded-lg hover:bg-slate-800 text-slate-200";
}

<aside class="rounded-xl border border-slate-800 bg-slate-900 p-4 h-fit">
    <p class="text-xs uppercase tracking-widest text-slate-400 mb-3">Administrator</p>
    <nav class="space-y-2 text-sm">
        <a href="/admin" class="@LinkClass("overview")">Overview</a>
        <a href="/admin/trials" class="@LinkClass("trials")">Trial Licenses</a>
        <a href="/admin/paid-licenses" class="@LinkClass("paid")">Paid Licenses</a>
        <a href="/admin/billing" class="@LinkClass("billing")">Billing</a>
        <a href="/admin/discounts" class="@LinkClass("discounts")">Discounts</a>
    </nav>
</aside>
