@page "/admin/discounts"
@model OmniRelay.Backend.Pages.Admin.DiscountsModel
@{
    ViewData["Title"] = S["Admin.Discounts.Title"];
    ViewData["AdminNav"] = "discounts";
}

<div class="max-w-7xl mx-auto px-4 py-10 grid md:grid-cols-[240px_1fr] gap-6">
    <partial name="_AdminSidebar" view-data="ViewData" />

    <section class="space-y-5">
        <div>
            <h1 class="text-3xl font-bold">@S["Admin.Discounts.Title"]</h1>
            <p class="text-slate-400 mt-1">@S["Admin.Discounts.Subtitle"]</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.NoticeMessage))
        {
            <div class="rounded-lg border border-emerald-500/50 bg-emerald-950/30 px-4 py-3 text-sm text-emerald-200">
                @Model.NoticeMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="rounded-lg border border-rose-500/50 bg-rose-950/30 px-4 py-3 text-sm text-rose-200">
                @Model.ErrorMessage
            </div>
        }

        <section class="rounded-xl border border-slate-800 bg-slate-900 p-5">
            <h2 class="text-lg font-semibold">@S["Admin.Discounts.CreateCoupon"]</h2>
            <p class="mt-1 text-sm text-slate-400">@S["Admin.Discounts.CreateHelp"]</p>

            <form method="post" asp-page-handler="Create" class="mt-4 grid gap-4 md:grid-cols-4">
                <div class="md:col-span-2 space-y-1">
                    <label asp-for="Input.Code" class="text-sm text-slate-300">@S["Admin.Discounts.CouponCodeOptional"]</label>
                    <input asp-for="Input.Code" maxlength="64" class="w-full rounded border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100 focus:border-cyan-400 focus:outline-none" />
                    <p class="text-xs text-slate-500">@S["Admin.Discounts.CodeAllowed"]</p>
                    <span asp-validation-for="Input.Code" class="text-xs text-rose-300"></span>
                </div>

                <div class="space-y-1">
                    <label asp-for="Input.DiscountPercent" class="text-sm text-slate-300">@S["Admin.Discounts.DiscountPercent"]</label>
                    <input asp-for="Input.DiscountPercent" type="number" min="1" max="99" class="w-full rounded border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100 focus:border-cyan-400 focus:outline-none" />
                    <span asp-validation-for="Input.DiscountPercent" class="text-xs text-rose-300"></span>
                </div>

                <div class="space-y-1">
                    <label asp-for="Input.MaxUses" class="text-sm text-slate-300">@S["Admin.Discounts.MaxUses"]</label>
                    <input asp-for="Input.MaxUses" type="number" min="1" class="w-full rounded border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100 focus:border-cyan-400 focus:outline-none" />
                    <span asp-validation-for="Input.MaxUses" class="text-xs text-rose-300"></span>
                </div>

                <div class="md:col-span-4 flex items-center gap-3">
                    <button type="submit" class="rounded bg-cyan-500 px-4 py-2 text-sm font-semibold text-slate-900 hover:bg-cyan-400">@S["Admin.Discounts.CreateButton"]</button>
                    <div asp-validation-summary="ModelOnly" class="text-xs text-rose-300"></div>
                </div>
            </form>
        </section>

        <div class="flex items-center justify-between text-sm text-slate-300">
            <p>@S["Common.Total"] <strong>@Model.TotalItems</strong></p>
            <p>@S["Admin.Card.Active"] <strong>@Model.ActiveItems</strong></p>
            <p>@S["Common.PageXofY", Model.PageNumber, Model.TotalPages]</p>
        </div>

        @if (Model.Items.Count == 0)
        {
            <div class="rounded-xl border border-slate-800 bg-slate-900 p-6 text-slate-300">@S["Admin.Discounts.Empty"]</div>
        }
        else
        {
            <div class="overflow-x-auto rounded-xl border border-slate-800 bg-slate-900">
                <table class="min-w-full text-sm">
                    <thead class="bg-slate-950/70 text-slate-300">
                        <tr>
                            <th class="text-left px-4 py-3">@S["Admin.Discounts.Table.Code"]</th>
                            <th class="text-left px-4 py-3">@S["Admin.Discounts.Table.Discount"]</th>
                            <th class="text-left px-4 py-3">@S["Admin.Discounts.Table.UsedMax"]</th>
                            <th class="text-left px-4 py-3">@S["Admin.Discounts.Table.Remaining"]</th>
                            <th class="text-left px-4 py-3">@S["Admin.Discounts.Table.Status"]</th>
                            <th class="text-left px-4 py-3">@S["Admin.Discounts.Table.Created"]</th>
                            <th class="text-left px-4 py-3">@S["Admin.Discounts.Table.Creator"]</th>
                            <th class="text-left px-4 py-3">@S["Admin.Discounts.Table.Action"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr class="border-t border-slate-800">
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-2">
                                    <code class="font-mono text-xs text-cyan-300">@item.Code</code>
                                    <button type="button" class="copy-discount-code rounded bg-slate-800 px-2 py-1 text-xs hover:bg-slate-700" data-code="@item.Code">@S["Js.Copy.Copy"]</button>
                                </div>
                            </td>
                            <td class="px-4 py-3">@item.DiscountPercent%</td>
                            <td class="px-4 py-3">@item.TimesRedeemed / @item.MaxUses</td>
                            <td class="px-4 py-3">@item.RemainingUses</td>
                            <td class="px-4 py-3">
                                @if (item.IsActive)
                                {
                                    <span class="rounded-full bg-emerald-500/20 px-2 py-1 text-xs text-emerald-300">@S["Common.Active"]</span>
                                }
                                else
                                {
                                    <span class="rounded-full bg-slate-700 px-2 py-1 text-xs text-slate-300">@S["Common.Disabled"]</span>
                                }
                            </td>
                            <td class="px-4 py-3">@item.CreatedAt.ToString("u")</td>
                            <td class="px-4 py-3">@(string.IsNullOrWhiteSpace(item.CreatorEmail) ? S["Common.NotAvailable"].Value : item.CreatorEmail)</td>
                            <td class="px-4 py-3">
                                @if (item.IsActive)
                                {
                                    <form method="post" asp-page-handler="Disable" class="inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                                        <button type="submit" class="rounded border border-rose-400 px-2 py-1 text-xs text-rose-200 hover:bg-rose-950/40">
                                            @S["Common.Disable"]
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-xs text-slate-500">@S["Common.NotAvailable"]</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="flex items-center justify-between">
                @if (Model.PageNumber > 1)
                {
                    <a class="rounded bg-slate-800 px-3 py-2 text-sm hover:bg-slate-700" href="/admin/discounts?pageNumber=@(Model.PageNumber - 1)">@S["Common.Previous"]</a>
                }
                else
                {
                    <span class="rounded bg-slate-900 px-3 py-2 text-sm text-slate-500">@S["Common.Previous"]</span>
                }

                @if (Model.PageNumber < Model.TotalPages)
                {
                    <a class="rounded bg-slate-800 px-3 py-2 text-sm hover:bg-slate-700" href="/admin/discounts?pageNumber=@(Model.PageNumber + 1)">@S["Common.Next"]</a>
                }
                else
                {
                    <span class="rounded bg-slate-900 px-3 py-2 text-sm text-slate-500">@S["Common.Next"]</span>
                }
            </div>
        }
    </section>
</div>

@section Scripts {
    <script>
        (function () {
            const i18n = window.omniRelayI18n || {};
            const copiedLabel = i18n["copy.copied"] || @Html.Raw(System.Text.Json.JsonSerializer.Serialize(S["Js.Copy.Copied"].Value));
            const copyLabel = i18n["copy.copy"] || @Html.Raw(System.Text.Json.JsonSerializer.Serialize(S["Js.Copy.Copy"].Value));
            const copyFailedLabel = i18n["copy.failed"] || @Html.Raw(System.Text.Json.JsonSerializer.Serialize(S["Js.Copy.Failed"].Value));
            document.querySelectorAll(".copy-discount-code").forEach(function (button) {
                button.addEventListener("click", async function () {
                    const code = button.getAttribute("data-code") || "";
                    if (!code) return;
                    try {
                        await navigator.clipboard.writeText(code);
                        const oldText = button.textContent;
                        button.textContent = copiedLabel;
                        setTimeout(function () {
                            button.textContent = oldText || copyLabel;
                        }, 1000);
                    } catch {
                        button.textContent = copyFailedLabel;
                        setTimeout(function () {
                            button.textContent = copyLabel;
                        }, 1000);
                    }
                });
            });
        })();
    </script>
}
