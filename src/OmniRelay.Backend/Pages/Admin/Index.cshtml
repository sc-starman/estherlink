@page "/admin"
@model OmniRelay.Backend.Pages.Admin.IndexModel
@{
    ViewData["Title"] = S["Admin.Title"];
    ViewData["AdminNav"] = "overview";
}

<div class="max-w-7xl mx-auto px-4 py-10 grid md:grid-cols-[240px_1fr] gap-6">
    <partial name="_AdminSidebar" view-data="ViewData" />

    <section class="space-y-6">
        <div>
            <h1 class="text-3xl font-bold">@S["Admin.Title"]</h1>
            <p class="text-slate-400 mt-1">@S["Admin.Subtitle"]</p>
        </div>

        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
            <article class="rounded-xl border border-slate-800 bg-slate-900 p-5">
                <p class="text-xs uppercase tracking-widest text-slate-400">@S["Admin.Card.TrialLicenses"]</p>
                <p class="mt-2 text-3xl font-bold">@Model.TrialLicenses</p>
                <a href="/admin/trials" class="mt-3 inline-block text-sm text-cyan-300 hover:text-cyan-200">@S["Admin.Card.OpenList"]</a>
            </article>

            <article class="rounded-xl border border-slate-800 bg-slate-900 p-5">
                <p class="text-xs uppercase tracking-widest text-slate-400">@S["Admin.Card.PaidLicenses"]</p>
                <p class="mt-2 text-3xl font-bold">@Model.PaidLicenses</p>
                <a href="/admin/paid-licenses" class="mt-3 inline-block text-sm text-cyan-300 hover:text-cyan-200">@S["Admin.Card.OpenList"]</a>
            </article>

            <article class="rounded-xl border border-slate-800 bg-slate-900 p-5">
                <p class="text-xs uppercase tracking-widest text-slate-400">@S["Admin.Card.BillingOrders"]</p>
                <p class="mt-2 text-3xl font-bold">@Model.BillingOrders</p>
                <a href="/admin/billing" class="mt-3 inline-block text-sm text-cyan-300 hover:text-cyan-200">@S["Admin.Card.OpenList"]</a>
            </article>

            <article class="rounded-xl border border-slate-800 bg-slate-900 p-5">
                <p class="text-xs uppercase tracking-widest text-slate-400">@S["Admin.Card.DiscountCoupons"]</p>
                <p class="mt-2 text-3xl font-bold">@Model.DiscountCoupons</p>
                <p class="mt-1 text-xs text-slate-400">@S["Admin.Card.Active"] @Model.ActiveDiscountCoupons</p>
                <a href="/admin/discounts" class="mt-3 inline-block text-sm text-cyan-300 hover:text-cyan-200">@S["Admin.Card.OpenList"]</a>
            </article>
        </div>
    </section>
</div>
