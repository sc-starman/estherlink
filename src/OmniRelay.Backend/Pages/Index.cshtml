@page "/"
@model OmniRelay.Backend.Pages.IndexModel
@{
    ViewData["Title"] = S["Index.Title"];
    var landing = Model.Landing;
}

<section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-cyan-500/20 via-transparent to-slate-900"></div>
    <div class="max-w-7xl mx-auto px-4 py-24 relative">
        <p class="uppercase tracking-[0.25em] text-cyan-300 text-sm mb-4">@S["Layout.Brand"]</p>
        <h1 class="text-5xl font-bold leading-tight max-w-5xl">@landing.HeroHeadline</h1>
        <p class="mt-6 text-lg text-slate-300 max-w-4xl">@landing.HeroSubheadline</p>
        <div class="mt-8 flex flex-wrap gap-4">
            <a href="@landing.PrimaryCtaUrl" class="px-6 py-3 rounded-md bg-cyan-500 text-slate-900 font-semibold hover:bg-cyan-400">@landing.PrimaryCtaText</a>
            <a href="@landing.SecondaryCtaUrl" class="px-6 py-3 rounded-md border border-slate-700 hover:border-cyan-400">@landing.SecondaryCtaText</a>
        </div>
    </div>
</section>

<section class="max-w-7xl mx-auto px-4 py-16">
        <h2 class="text-3xl font-bold mb-4">@S["Index.Problem.Title"]</h2>
        <p class="text-slate-300 max-w-4xl">
            @S["Index.Problem.Body"]
        </p>
        <div class="grid md:grid-cols-3 gap-4 mt-8">
            <article class="p-5 rounded-xl border border-slate-800 bg-slate-900">
                <h3 class="font-semibold text-slate-100 mb-2">@S["Index.Problem.Card1.Title"]</h3>
                <p class="text-slate-300 text-sm">@S["Index.Problem.Card1.Body"]</p>
            </article>
            <article class="p-5 rounded-xl border border-slate-800 bg-slate-900">
                <h3 class="font-semibold text-slate-100 mb-2">@S["Index.Problem.Card2.Title"]</h3>
                <p class="text-slate-300 text-sm">@S["Index.Problem.Card2.Body"]</p>
            </article>
            <article class="p-5 rounded-xl border border-slate-800 bg-slate-900">
                <h3 class="font-semibold text-slate-100 mb-2">@S["Index.Problem.Card3.Title"]</h3>
                <p class="text-slate-300 text-sm">@S["Index.Problem.Card3.Body"]</p>
            </article>
        </div>
</section>

<section class="max-w-7xl mx-auto px-4 py-8">
    <h2 class="text-3xl font-bold mb-4">@S["Index.Solution.Title"]</h2>
    <p class="text-slate-300 max-w-4xl">
        @S["Index.Solution.Body"]
    </p>
    <div class="mt-8">
        <a href="@landing.MidCtaUrl" class="inline-flex px-6 py-3 rounded-md bg-cyan-500 text-slate-900 font-semibold hover:bg-cyan-400">@landing.MidCtaText</a>
    </div>
</section>

<section class="max-w-7xl mx-auto px-4 py-12">
    <h2 class="text-3xl font-bold mb-6">@S["Index.Features.Title"]</h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var benefit in landing.BenefitBlocks)
        {
            <article class="p-6 rounded-xl border border-slate-800 bg-slate-900">
                <p class="text-slate-200">@benefit</p>
            </article>
        }
    </div>
</section>

<section class="max-w-7xl mx-auto px-4 py-8">
    <h2 class="text-3xl font-bold mb-6">@S["Index.UseCases.Title"]</h2>
    <div class="grid md:grid-cols-2 gap-6">
        <article class="p-6 rounded-xl border border-slate-800 bg-slate-900">
            <h3 class="font-semibold text-slate-100 mb-2">@S["Index.UseCases.Card1.Title"]</h3>
            <p class="text-slate-300">@S["Index.UseCases.Card1.Body"]</p>
        </article>
        <article class="p-6 rounded-xl border border-slate-800 bg-slate-900">
            <h3 class="font-semibold text-slate-100 mb-2">@S["Index.UseCases.Card2.Title"]</h3>
            <p class="text-slate-300">@S["Index.UseCases.Card2.Body"]</p>
        </article>
        <article class="p-6 rounded-xl border border-slate-800 bg-slate-900">
            <h3 class="font-semibold text-slate-100 mb-2">@S["Index.UseCases.Card3.Title"]</h3>
            <p class="text-slate-300">@S["Index.UseCases.Card3.Body"]</p>
        </article>
        <article class="p-6 rounded-xl border border-slate-800 bg-slate-900">
            <h3 class="font-semibold text-slate-100 mb-2">@S["Index.UseCases.Card4.Title"]</h3>
            <p class="text-slate-300">@S["Index.UseCases.Card4.Body"]</p>
        </article>
        <article class="p-6 rounded-xl border border-slate-800 bg-slate-900 md:col-span-2">
            <h3 class="font-semibold text-slate-100 mb-2">@S["Index.UseCases.Card5.Title"]</h3>
            <p class="text-slate-300">@S["Index.UseCases.Card5.Body"]</p>
        </article>
    </div>
</section>

<section class="max-w-7xl mx-auto px-4 py-8">
    <div class="rounded-xl border border-cyan-700/40 bg-cyan-500/10 p-8">
        <h2 class="text-3xl font-bold">@S["Index.Security.Title"]</h2>
        <p class="text-slate-200 mt-3 max-w-4xl">
            @S["Index.Security.Body"]
        </p>
        <ul class="mt-6 grid md:grid-cols-2 gap-3 text-slate-200 text-sm">
            <li class="rounded border border-slate-700/70 bg-slate-900/60 px-3 py-2">@S["Index.Security.Bullet1"]</li>
            <li class="rounded border border-slate-700/70 bg-slate-900/60 px-3 py-2">@S["Index.Security.Bullet2"]</li>
            <li class="rounded border border-slate-700/70 bg-slate-900/60 px-3 py-2">@S["Index.Security.Bullet3"]</li>
            <li class="rounded border border-slate-700/70 bg-slate-900/60 px-3 py-2">@S["Index.Security.Bullet4"]</li>
        </ul>
    </div>
</section>

<section id="how-it-works" class="max-w-7xl mx-auto px-4 py-10">
    <h2 class="text-3xl font-bold mb-6">@S["Index.HowItWorks.Title"]</h2>
    <div class="grid md:grid-cols-3 gap-6">
        @for (var i = 0; i < landing.HowItWorksSteps.Count; i++)
        {
            <article class="p-6 rounded-xl border border-slate-800 bg-slate-900">
                <p class="text-cyan-300 font-semibold mb-2">@S["Index.HowItWorks.Step", i + 1]</p>
                <p class="text-slate-200">@landing.HowItWorksSteps[i]</p>
            </article>
        }
    </div>
</section>

<section class="max-w-7xl mx-auto px-4 py-8">
    <div class="p-8 rounded-xl border border-cyan-600/40 bg-cyan-500/10">
        <h2 class="text-3xl font-bold">@S["Index.Pricing.Title"]</h2>
        <p class="text-slate-200 mt-3">@landing.OfferSummary</p>
        <p class="text-3xl font-bold mt-4">
            <span class="text-cyan-300">$99</span>
            <span class="text-xl text-slate-400 line-through ml-3" style="text-decoration: line-through;">$149</span>
        </p>
        <p class="text-slate-300 mt-2">@landing.OfferRiskReducer</p>
        <a href="@landing.MidCtaUrl" class="inline-flex mt-6 px-6 py-3 rounded-md bg-cyan-500 text-slate-900 font-semibold hover:bg-cyan-400">@landing.MidCtaText</a>
    </div>
</section>

<section class="max-w-7xl mx-auto px-4 py-14">
    <div class="p-8 rounded-xl border border-cyan-600/40 bg-slate-900">
        <h2 class="text-4xl font-bold">@landing.ClosingHeadline</h2>
        <p class="text-slate-300 mt-4 max-w-3xl">@landing.ClosingBody</p>
        <div class="mt-8 flex flex-wrap gap-4">
            <a href="@landing.FinalCtaUrl" class="px-6 py-3 rounded-md bg-cyan-500 text-slate-900 font-semibold hover:bg-cyan-400">@landing.FinalCtaText</a>
            <a href="/docs" class="px-6 py-3 rounded-md border border-slate-700 hover:border-cyan-400">@S["Index.ReadDocumentation"]</a>
        </div>
    </div>
</section>

<footer class="border-t border-slate-800 mt-10">
    <div class="max-w-7xl mx-auto px-4 py-10 grid md:grid-cols-2 gap-6">
        <div>
            <h3 class="font-bold text-xl">@S["Layout.Brand"]</h3>
            <p class="text-slate-400 mt-2">@S["Index.Footer.Body"]</p>
        </div>
        <div class="grid grid-cols-2 gap-3 text-sm">
            <a href="/docs" class="hover:text-cyan-300">@S["Layout.Nav.Documentation"]</a>
            <a href="/download" class="hover:text-cyan-300">@S["Layout.Nav.Download"]</a>
            <a href="/dashboard/licenses" class="hover:text-cyan-300">@S["Index.Footer.License"]</a>
            <a href="/contact" class="hover:text-cyan-300">@S["Layout.Nav.Contact"]</a>
        </div>
    </div>
</footer>
