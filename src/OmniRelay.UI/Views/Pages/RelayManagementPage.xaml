<Page x:Class="OmniRelay.UI.Views.Pages.RelayManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Relay Service"
      Background="{DynamicResource Brush.Background}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28" MaxWidth="980">
            <TextBlock Text="Configure and operate the Windows Relay service independently from VPS gateway operations."
                       Style="{StaticResource MutedTextStyle}"
                       Margin="0,0,0,16"/>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Proxy Listen Port" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding State.ProxyPortText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>

                    <TextBlock Grid.Row="1" Text="VPS Network (IC1)" Style="{StaticResource FormLabelStyle}"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              ItemsSource="{Binding State.Adapters}"
                              SelectedItem="{Binding State.VpsAdapter}"
                              DisplayMemberPath="Display"
                              Style="{StaticResource FormComboBoxStyle}"/>

                    <TextBlock Grid.Row="2" Text="Outgoing Network (IC2)" Style="{StaticResource FormLabelStyle}"/>
                    <ComboBox Grid.Row="2" Grid.Column="1"
                              ItemsSource="{Binding State.Adapters}"
                              SelectedItem="{Binding State.OutgoingAdapter}"
                              DisplayMemberPath="Display"
                              Style="{StaticResource FormComboBoxStyle}"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Relay Service Operations" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <Button Content="Apply Relay Config" Command="{Binding ApplyRelayConfigCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                    </WrapPanel>
                                        <WrapPanel Margin="0,10,0,0">
                        <Button Content="Install/Start Relay" Command="{Binding InstallStartRelayCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="Stop Relay" Command="{Binding StopRelayCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="Uninstall Relay" Command="{Binding UninstallRelayCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Service State" Style="{StaticResource FormLabelStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ServiceState}" Style="{StaticResource ValueTextStyle}"/>

                    <TextBlock Grid.Row="1" Text="Proxy Running" Style="{StaticResource FormLabelStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Status.ProxyRunning}" Style="{StaticResource ValueTextStyle}"/>

                    <TextBlock Grid.Row="2" Text="Proxy Listen Port" Style="{StaticResource FormLabelStyle}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Status.ProxyListenPort}" Style="{StaticResource ValueTextStyle}"/>

                    <TextBlock Grid.Row="3" Text="Status Stale" Style="{StaticResource FormLabelStyle}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StatusStale}" Style="{StaticResource ValueTextStyle}"/>

                    <TextBlock Grid.Row="4" Text="Tunnel State" Style="{StaticResource FormLabelStyle}"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding EffectiveTunnelState}" Style="{StaticResource ValueTextStyle}"/>

                    <TextBlock Grid.Row="5" Text="Health State" Style="{StaticResource FormLabelStyle}"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding HealthStateDisplay}" Style="{StaticResource ValueTextStyle}"/>

                    <TextBlock Grid.Row="6" Text="Health Reason" Style="{StaticResource FormLabelStyle}"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding HealthReasonDisplay}" TextWrapping="Wrap" Style="{StaticResource ValueTextStyle}"/>

                    <TextBlock Grid.Row="7" Text="Recovery Tier" Style="{StaticResource FormLabelStyle}"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Status.RecoveryTier}" Style="{StaticResource ValueTextStyle}"/>

                    <TextBlock Grid.Row="8" Text="Recovery Action" Style="{StaticResource FormLabelStyle}"/>
                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Status.RecoveryAction}" Style="{StaticResource ValueTextStyle}" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="9" Text="Consecutive Failures" Style="{StaticResource FormLabelStyle}"/>
                    <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Status.ConsecutiveFailures}" Style="{StaticResource ValueTextStyle}"/>

                    <TextBlock Grid.Row="10" Text="Last Healthy (UTC)" Style="{StaticResource FormLabelStyle}"/>
                    <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding Status.LastHealthyUtc}" Style="{StaticResource ValueTextStyle}"/>

                    <TextBlock Grid.Row="11" Text="Last Local Probe (UTC)" Style="{StaticResource FormLabelStyle}"/>
                    <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding Status.LastLocalProbeUtc}" Style="{StaticResource ValueTextStyle}"/>

                    <TextBlock Grid.Row="12" Text="Last End-to-End Probe (UTC)" Style="{StaticResource FormLabelStyle}"/>
                    <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding Status.LastEndToEndProbeUtc}" Style="{StaticResource ValueTextStyle}"/>

                    <TextBlock Grid.Row="13" Text="Tunnel Last Error" Style="{StaticResource FormLabelStyle}"/>
                    <TextBlock Grid.Row="13" Grid.Column="1" Text="{Binding Status.TunnelLastError}" TextWrapping="Wrap" Style="{StaticResource ValueTextStyle}"/>

                    <TextBlock Grid.Row="14"
                               Grid.ColumnSpan="2"
                               Margin="0,10,0,0"
                               Text="{Binding TunnelModuleNote}"
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}"
                               Foreground="{DynamicResource Brush.Warning}"
                               Visibility="{Binding ShowTunnelModuleNote, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <TextBlock Text="{Binding Feedback}" Style="{StaticResource FeedbackTextStyle}" Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
