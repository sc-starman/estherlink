@page "/docs"
@model OmniRelay.Backend.Pages.DocsModel
@{
    ViewData["Title"] = S["Docs.Title"];
}

<section class="max-w-7xl mx-auto px-4 py-10 space-y-10">
    <header class="space-y-3">
        <h1 class="text-4xl font-bold">@S["Docs.Heading"]</h1>
        <p class="text-slate-300 max-w-4xl">
            @S["Docs.Subtitle"]
        </p>
        <p class="text-sm text-slate-400">@S["Docs.LastUpdated"] @Model.LastUpdated</p>
    </header>

    <nav class="rounded-xl border border-slate-800 bg-slate-900 p-4">
        <p class="text-sm uppercase tracking-wide text-slate-400 mb-3">@S["Docs.Sections"]</p>
        <div class="flex flex-wrap gap-3 text-sm">
            <a class="px-3 py-1 rounded border border-slate-700 hover:border-cyan-400" href="#introduction">@S["Docs.Section1"]</a>
            <a class="px-3 py-1 rounded border border-slate-700 hover:border-cyan-400" href="#requirements">@S["Docs.Section2"]</a>
            <a class="px-3 py-1 rounded border border-slate-700 hover:border-cyan-400" href="#installation">@S["Docs.Section3"]</a>
            <a class="px-3 py-1 rounded border border-slate-700 hover:border-cyan-400" href="#first-launch">@S["Docs.Section4"]</a>
            <a class="px-3 py-1 rounded border border-slate-700 hover:border-cyan-400" href="#activation">@S["Docs.Section5"]</a>
            <a class="px-3 py-1 rounded border border-slate-700 hover:border-cyan-400" href="#relay-config">@S["Docs.Section6"]</a>
            <a class="px-3 py-1 rounded border border-slate-700 hover:border-cyan-400" href="#start-relay">@S["Docs.Section7"]</a>
            <a class="px-3 py-1 rounded border border-slate-700 hover:border-cyan-400" href="#monitoring">@S["Docs.Section8"]</a>
            <a class="px-3 py-1 rounded border border-slate-700 hover:border-cyan-400" href="#troubleshooting">@S["Docs.Section9"]</a>
            <a class="px-3 py-1 rounded border border-slate-700 hover:border-cyan-400" href="#updating">@S["Docs.Section10"]</a>
        </div>
    </nav>

    <section id="introduction" class="space-y-4">
        <h2 class="text-3xl font-bold">@S["Docs.Section1"]</h2>
        <div class="space-y-3 text-slate-200">
            @foreach (var line in Model.Introduction)
            {
                <p>@line</p>
            }
        </div>
        <p class="text-sm text-slate-400">@S["Docs.Placeholder.Introduction"]</p>
    </section>

    <section id="requirements" class="space-y-4">
        <h2 class="text-3xl font-bold">@S["Docs.Section2"]</h2>
        <ul class="list-disc pl-6 text-slate-200 space-y-2">
            @foreach (var item in Model.SystemRequirements)
            {
                <li>@item</li>
            }
        </ul>
        <p class="text-sm text-slate-400">@S["Docs.Placeholder.Requirements"]</p>
    </section>

    <section id="installation" class="space-y-4">
        <h2 class="text-3xl font-bold">@S["Docs.Section3"]</h2>
        <ol class="list-decimal pl-6 text-slate-200 space-y-2">
            @foreach (var step in Model.InstallationSteps)
            {
                <li>@step</li>
            }
        </ol>
        <p class="text-sm text-slate-400">@S["Docs.Placeholder.Installation"]</p>
    </section>

    <section id="first-launch" class="space-y-4">
        <h2 class="text-3xl font-bold">@S["Docs.Section4"]</h2>
        <ol class="list-decimal pl-6 text-slate-200 space-y-2">
            @foreach (var step in Model.FirstLaunchSteps)
            {
                <li>@step</li>
            }
        </ol>
        <p class="text-sm text-slate-400">@S["Docs.Placeholder.FirstLaunch"]</p>
    </section>

    <section id="activation" class="space-y-4">
        <h2 class="text-3xl font-bold">@S["Docs.Section5"]</h2>
        <ol class="list-decimal pl-6 text-slate-200 space-y-2">
            @foreach (var step in Model.LicenseActivationSteps)
            {
                <li>@step</li>
            }
        </ol>
        <p class="text-sm text-slate-400">@S["Docs.Placeholder.Activation"]</p>
    </section>

    <section id="relay-config" class="space-y-4">
        <h2 class="text-3xl font-bold">@S["Docs.Section6"]</h2>
        <p class="text-slate-300">
            @Html.Raw(S["Docs.RelayConfig.Intro"])
        </p>
        <div class="overflow-auto rounded-xl border border-slate-800">
            <table class="min-w-full text-sm">
                <thead class="bg-slate-900 text-slate-300">
                    <tr>
                        <th class="text-left p-3">@S["Docs.RelayConfig.Table.Field"]</th>
                        <th class="text-left p-3">@S["Docs.RelayConfig.Table.WhatSet"]</th>
                        <th class="text-left p-3">@S["Docs.RelayConfig.Table.ValidValues"]</th>
                        <th class="text-left p-3">@S["Docs.RelayConfig.Table.OperatorNotes"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.RelayConfigRows)
                    {
                        <tr class="border-t border-slate-800 bg-slate-950/40 align-top">
                            <td class="p-3 font-semibold">@row.Field</td>
                            <td class="p-3">@row.Description</td>
                            <td class="p-3">@row.ValidValues</td>
                            <td class="p-3">@row.OperatorNotes</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="text-sm text-slate-400">@S["Docs.Placeholder.RelayConfig"]</p>
    </section>

    <section id="start-relay" class="space-y-4">
        <h2 class="text-3xl font-bold">@S["Docs.Section7"]</h2>
        <ol class="list-decimal pl-6 text-slate-200 space-y-2">
            @foreach (var step in Model.StartingRelaySteps)
            {
                <li>@step</li>
            }
        </ol>
        <p class="text-sm text-slate-400">@S["Docs.Placeholder.StartRelay"]</p>
    </section>

    <section id="monitoring" class="space-y-4">
        <h2 class="text-3xl font-bold">@S["Docs.Section8"]</h2>
        <p class="text-slate-300">
            @S["Docs.Monitoring.Intro"]
        </p>
        <div class="overflow-auto rounded-xl border border-slate-800">
            <table class="min-w-full text-sm">
                <thead class="bg-slate-900 text-slate-300">
                    <tr>
                        <th class="text-left p-3">@S["Docs.Monitoring.Table.Indicator"]</th>
                        <th class="text-left p-3">@S["Docs.Monitoring.Table.Meaning"]</th>
                        <th class="text-left p-3">@S["Docs.Monitoring.Table.Expected"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.MonitoringRows)
                    {
                        <tr class="border-t border-slate-800 bg-slate-950/40 align-top">
                            <td class="p-3 font-semibold">@row.Indicator</td>
                            <td class="p-3">@row.Meaning</td>
                            <td class="p-3">@row.ExpectedValue</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="text-sm text-slate-400">@S["Docs.Placeholder.Monitoring"]</p>
    </section>

    <section id="troubleshooting" class="space-y-4">
        <h2 class="text-3xl font-bold">@S["Docs.Section9"]</h2>
        <div class="overflow-auto rounded-xl border border-slate-800">
            <table class="min-w-full text-sm">
                <thead class="bg-slate-900 text-slate-300">
                    <tr>
                        <th class="text-left p-3">@S["Docs.Troubleshooting.Table.Problem"]</th>
                        <th class="text-left p-3">@S["Docs.Troubleshooting.Table.Action"]</th>
                        <th class="text-left p-3">@S["Docs.Troubleshooting.Table.Confirm"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.TroubleshootingRows)
                    {
                        <tr class="border-t border-slate-800 bg-slate-950/40 align-top">
                            <td class="p-3 font-semibold">@row.Problem</td>
                            <td class="p-3">@row.Action</td>
                            <td class="p-3">@row.SuccessCheck</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="text-sm text-slate-400">@S["Docs.Placeholder.Troubleshooting"]</p>
    </section>

    <section id="updating" class="space-y-4">
        <h2 class="text-3xl font-bold">@S["Docs.Section10"]</h2>
        <ol class="list-decimal pl-6 text-slate-200 space-y-2">
            @foreach (var step in Model.UpdateSteps)
            {
                <li>@step</li>
            }
        </ol>
        <p class="text-sm text-slate-400">@S["Docs.Placeholder.Updating"]</p>
    </section>
</section>
