<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OmniRelay.Core\OmniRelay.Core.csproj" />
    <ProjectReference Include="..\OmniRelay.Ipc\OmniRelay.Ipc.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="scripts\setup_omnirelay_vps_singbox.sh"
             Condition="Exists('scripts\\setup_omnirelay_vps_singbox.sh')"
             CopyToOutputDirectory="PreserveNewest"
             Link="GatewayScripts\\setup_omnirelay_vps_singbox.sh" />
    <Content Include="scripts\setup_omnirelay_vps_openvpn_singbox.sh"
             Condition="Exists('scripts\\setup_omnirelay_vps_openvpn_singbox.sh')"
             CopyToOutputDirectory="PreserveNewest"
             Link="GatewayScripts\\setup_omnirelay_vps_openvpn_singbox.sh" />
    <Content Include="scripts\setup_omnirelay_vps_ipsec_l2tp_singbox.sh"
             Condition="Exists('scripts\\setup_omnirelay_vps_ipsec_l2tp_singbox.sh')"
             CopyToOutputDirectory="PreserveNewest"
             Link="GatewayScripts\\setup_omnirelay_vps_ipsec_l2tp_singbox.sh" />
    <Content Include="scripts\setup_omnirelay_gateway_singbox_connector_common.sh"
             Condition="Exists('scripts\\setup_omnirelay_gateway_singbox_connector_common.sh')"
             CopyToOutputDirectory="PreserveNewest"
             Link="GatewayScripts\\setup_omnirelay_gateway_singbox_connector_common.sh" />
    <Content Include="scripts\setup_omnirelay_omnipanel_common.sh"
             Condition="Exists('scripts\\setup_omnirelay_omnipanel_common.sh')"
             CopyToOutputDirectory="PreserveNewest"
             Link="GatewayScripts\\setup_omnirelay_omnipanel_common.sh" />
    <Content Include="scripts\setup_omnirelay_gateway_bootstrap_common.sh"
             Condition="Exists('scripts\\setup_omnirelay_gateway_bootstrap_common.sh')"
             CopyToOutputDirectory="PreserveNewest"
             Link="GatewayScripts\\setup_omnirelay_gateway_bootstrap_common.sh" />
    <Content Include="scripts\setup_omnirelay_gateway_tunnel_module.sh"
             Condition="Exists('scripts\\setup_omnirelay_gateway_tunnel_module.sh')"
             CopyToOutputDirectory="PreserveNewest"
             Link="GatewayScripts\\setup_omnirelay_gateway_tunnel_module.sh" />
    <Content Include="..\OmniRelay.Installer\Product.wxs"
             Condition="Exists('..\\OmniRelay.Installer\\Product.wxs')"
             CopyToOutputDirectory="PreserveNewest"
             Link="InstallerMetadata\\Product.metadata.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="SSH.NET" Version="2024.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**\*</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="artifacts\**\*.cs" />
    <EmbeddedResource Remove="artifacts\**\*" />
    <None Remove="artifacts\**\*" />
  </ItemGroup>

</Project>
